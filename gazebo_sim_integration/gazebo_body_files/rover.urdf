<?xml version="1.0"?>
<robot name="alam_rover2">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.33" rpy="0 0 0"/>
      <geometry><box size="1.20 0.78 0.24"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.33" rpy="0 0 0"/>
      <geometry><box size="1.20 0.78 0.24"/></geometry>
    </collision>
    <inertial>
      <mass value="55.0"/>
      <origin xyz="0 0 0.33" rpy="0 0 0"/>
      <inertia ixx="3.5" ixy="0.0" ixz="0.0" iyy="8.0" iyz="0.0" izz="9.0"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <self_collide>false</self_collide>
    <visual>
      <material>
        <ambient>0.6 0.6 0.6 1.0</ambient>
        <diffuse>0.6 0.6 0.6 1.0</diffuse>
        <pbr>
          <metal>
            <albedo_map>file:///root/ws/assets/custom/rover_body_2/textures/Silver/Poliigon_MetalSteelBrushed_7174_BaseColor.jpg</albedo_map>
            
            
            
            
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>

  <link name="mast_link">
    <visual>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.80"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.80"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="-0.42 0 0.45" rpy="0 0 0"/>
  </joint>
  <gazebo reference="mast_link">
    <visual>
      <material>
        <ambient>0.35 0.35 0.35 1.0</ambient>
        <diffuse>0.35 0.35 0.35 1.0</diffuse>
        <pbr>
          <metal>
            <albedo_map>file:///root/ws/assets/custom/rover_body_2/textures/Plastic/Poliigon_PlasticMoldDryBlast_7495_BaseColor.jpg</albedo_map>
            
            
            
            
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>

  <link name="arm_link">
    <visual>
      <origin xyz="0.20 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.08 0.05"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.20 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.08 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0.20 0 0" rpy="0 0 0"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>
  <joint name="arm_joint" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <origin xyz="0.46 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.50" upper="0.70" effort="60.0" velocity="0.8"/>
  </joint>

  <link name="bucket_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.18 0.34 0.14"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.18 0.34 0.14"/></geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="bucket_joint" type="fixed">
    <parent link="arm_link"/>
    <child link="bucket_link"/>
    <origin xyz="0.40 0 0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="bucket_link">
    <visual>
      <material>
        <ambient>0.55 0.45 0.10 1.0</ambient>
        <diffuse>0.55 0.45 0.10 1.0</diffuse>
        <pbr>
          <metal>
            <albedo_map>file:///root/ws/assets/custom/rover_body_2/textures/Gold/Poliigon_MetalGoldPaint_7253_BaseColor.jpg</albedo_map>
            
            
            
            
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>

  <link name="solar_panel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.70 0.44 0.02"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.70 0.44 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="solar_panel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="solar_panel_link"/>
    <origin xyz="0 0 0.48" rpy="0 0 0"/>
  </joint>
  <gazebo reference="solar_panel_link">
    <visual>
      <material>
        <ambient>0.20 0.20 0.25 1.0</ambient>
        <diffuse>0.20 0.20 0.25 1.0</diffuse>
        <pbr>
          <metal>
            <albedo_map>file:///root/ws/assets/custom/rover_body_2/textures/Slate/Poliigon_SlateFloorTile_7657_BaseColor.jpg</albedo_map>
            
            
            
            
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>

  <link name="front_left_wheel">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></collision>
    <inertial><mass value="4.0"/><origin xyz="0 0 0" rpy="1.5708 0 0"/><inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.04"/></inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_left_wheel"/><origin xyz="0.45 0.44 0.0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <gazebo reference="front_left_wheel"><mu1>1.10</mu1><mu2>0.95</mu2><self_collide>false</self_collide><visual><material><ambient>0.18 0.18 0.18 1.0</ambient><diffuse>0.18 0.18 0.18 1.0</diffuse><pbr><metal><albedo_map>file:///root/ws/assets/custom/rover_body_2/textures/Ceramic/TilesCeramicHerringbone002_COL_2K.jpg</albedo_map></metal></pbr></material></visual></gazebo>

  <link name="mid_left_wheel">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></collision>
    <inertial><mass value="4.0"/><origin xyz="0 0 0" rpy="1.5708 0 0"/><inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.04"/></inertial>
  </link>
  <joint name="mid_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="mid_left_wheel"/><origin xyz="0.0 0.44 0.0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <gazebo reference="mid_left_wheel"><mu1>1.10</mu1><mu2>0.95</mu2><self_collide>false</self_collide><visual><material><ambient>0.18 0.18 0.18 1.0</ambient><diffuse>0.18 0.18 0.18 1.0</diffuse><pbr><metal><albedo_map>file:///root/ws/assets/custom/rover_body_2/textures/Ceramic/TilesCeramicHerringbone002_COL_2K.jpg</albedo_map></metal></pbr></material></visual></gazebo>

