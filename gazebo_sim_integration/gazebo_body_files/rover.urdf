  </link>
  <joint name="rear_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel"/><origin xyz="-0.45 0.44 0.0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <gazebo reference="rear_left_wheel"><mu1>1.10</mu1><mu2>0.95</mu2><self_collide>false</self_collide><visual><material><ambient>0.18 0.18 0.18 1.0</ambient><diffuse>0.18 0.18 0.18 1.0</diffuse><pbr><metal><albedo_map>file:///root/ws/assets/custom/rover_body_2/textures/Ceramic/TilesCeramicHerringbone002_COL_2K.jpg</albedo_map></metal></pbr></material></visual></gazebo>

  <link name="front_right_wheel">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></collision>
