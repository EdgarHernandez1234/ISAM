<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lunar_rover">

    <xacro:property name="chassis_mass" value="40.0"/>
    <xacro:property name="chassis_length" value="1.0"/>
    <xacro:property name="chassis_width" value="0.6"/>
    <xacro:property name="chassis_height" value="0.8"/> <xacro:property name="wheel_mass" value="5.0"/>
    <xacro:property name="wheel_radius" value="0.2"/>
    <xacro:property name="wheel_width" value="0.15"/>
    
    <xacro:property name="moon_mu1" value="0.9"/>
    <xacro:property name="moon_mu2" value="0.7"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="${chassis_mass}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>

    <gazebo reference="base_link">
        <visual>
            <material>
                <pbr>
                    <metal>
                        <albedo_map>file://textures/Poliigon_MetalSteelBrushed_7174_BaseColor.jpg</albedo_map>
                        <normal_map>file://textures/Poliigon_MetalSteelBrushed_7174_Normal.jpg</normal_map>
                        <roughness_map>file://textures/Poliigon_MetalSteelBrushed_7174_Roughness.jpg</roughness_map>
                        <metalness_map>file://textures/Poliigon_MetalSteelBrushed_7174_Metallic.jpg</metalness_map>
                        <ambient_occlusion_map>file://textures/Poliigon_MetalSteelBrushed_7174_AmbientOcclusion.jpg</ambient_occlusion_map>
                    </metal>
                </pbr>
            </material>
        </visual>
    </gazebo>

    <link name="mast_link">
        <visual>
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="1.0"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="1.0"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="2.0"/>
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="mast_joint" type="fixed">
        <parent link="base_link"/>
        <child link="mast_link"/>
        <origin xyz="-0.4 0 ${chassis_height/2}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="mast_link">
        <visual>
            <material>
                <pbr>
                    <metal>
                        <albedo_map>file://textures/Poliigon_PlasticMoldDryBlast_7495_BaseColor.jpg</albedo_map>
                        <normal_map>file://textures/Poliigon_PlasticMoldDryBlast_7495_Normal.jpg</normal_map>
                        <roughness_map>file://textures/Poliigon_PlasticMoldDryBlast_7495_Roughness.jpg</roughness_map>
                        <metalness_map>file://textures/Poliigon_PlasticMoldDryBlast_7495_Metallic.jpg</metalness_map>
                        <ambient_occlusion_map>file://textures/Poliigon_PlasticMoldDryBlast_7495_AmbientOcclusion.jpg</ambient_occlusion_map>
                    </metal>
                </pbr>
            </material>
        </visual>
        <light type="spot" name="viper_headlight_left">
            <pose>0.1 0.2 0.8 0 0 0</pose>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>30</range>
                <linear>0.01</linear>
                <constant>0.2</constant>
                <quadratic>0.001</quadratic>
            </attenuation>
            <spot>
                <inner_angle>0.5</inner_angle>
                <outer_angle>1.0</outer_angle>
                <falloff>1.0</falloff>
            </spot>
            <cast_shadows>true</cast_shadows>
        </light>
    </gazebo>

    <link name="arm_link">
        <visual>
            <origin xyz="0.2 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.4 0.1 0.05"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.2 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.4 0.1 0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="3.0"/>
            <origin xyz="0.2 0 0" rpy="0 0 0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <joint name="arm_joint" type="revolute">
        <parent link="base_link"/>
        <child link="arm_link"/>
        <origin xyz="${chassis_length/2} 0 -0.2" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.5" upper="0.5" effort="100" velocity="1.0"/>
    </joint>

    <link name="bucket_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.6 0.3"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.6 0.3"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="5.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <joint name="bucket_joint" type="fixed">
        <parent link="arm_link"/>
        <child link="bucket_link"/>
        <origin xyz="0.4 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="bucket_link">
        <visual>
            <material>
                <pbr>
                    <metal>
                        <albedo_map>file://textures/Poliigon_MetalGoldPaint_7253_BaseColor.jpg</albedo_map>
                        <normal_map>file://textures/Poliigon_MetalGoldPaint_7253_Normal.jpg</normal_map>
                        <roughness_map>file://textures/Poliigon_MetalGoldPaint_7253_Roughness.jpg</roughness_map>
                        <metalness_map>file://textures/Poliigon_MetalGoldPaint_7253_Metallic.jpg</metalness_map>
                        <ambient_occlusion_map>file://textures/Poliigon_MetalGoldPaint_7253_AmbientOcclusion.jpg</ambient_occlusion_map>
                    </metal>
                </pbr>
            </material>
        </visual>
    </gazebo>

    <link name="solar_panel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.8 0.5 0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.8 0.5 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="solar_panel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="solar_panel_link"/>
        <origin xyz="0 0 ${chassis_height/2 + 0.02}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="solar_panel_link">
        <visual>
            <material>
                <pbr>
                    <metal>
                        <albedo_map>file://textures/Poliigon_SlateFloorTile_7657_BaseColor.jpg</albedo_map>
                        <normal_map>file://textures/Poliigon_SlateFloorTile_7657_Normal.jpg</normal_map>
                        <roughness_map>file://textures/Poliigon_SlateFloorTile_7657_Roughness.jpg</roughness_map>
                        <metalness_map>file://textures/Poliigon_SlateFloorTile_7657_Metallic.jpg</metalness_map>
                        <ambient_occlusion_map>file://textures/Poliigon_SlateFloorTile_7657_AmbientOcclusion.jpg</ambient_occlusion_map>
                    </metal>
                </pbr>
            </material>
        </visual>
    </gazebo>

    <xacro:macro name="rover_wheel" params="prefix x_offset y_offset">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="${wheel_mass}"/>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
            </inertial>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_offset} ${y_offset} -0.3" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <gazebo reference="${prefix}_wheel">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>${moon_mu1}</mu>
                            <mu2>${moon_mu2}</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual>
                <material>
                    <ambient>0.2 0.2 0.2 1.0</ambient> 
                    <diffuse>0.2 0.2 0.2 1.0</diffuse>
                    <pbr>
                        <metal>
                            <albedo_map>file://textures/TilesCeramicHerringbone002_COL_2K.jpg</albedo_map>
                            <normal_map>file://textures/TilesCeramicHerringbone002_NRM_2K.jpg</normal_map>
                            <roughness_map>file://textures/TilesCeramicHerringbone002_GLOSS_2K.jpg</roughness_map> 
                            <ambient_occlusion_map>file://textures/TilesCeramicHerringbone002_AO_2K.jpg</ambient_occlusion_map>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </gazebo>
    </xacro:macro>

    <xacro:rover_wheel prefix="front_left" x_offset="0.4" y_offset="0.4"/>
    <xacro:rover_wheel prefix="mid_left"   x_offset="0.0" y_offset="0.4"/>
    <xacro:rover_wheel prefix="rear_left"  x_offset="-0.4" y_offset="0.4"/>

    <xacro:rover_wheel prefix="front_right" x_offset="0.4" y_offset="-0.4"/>
    <xacro:rover_wheel prefix="mid_right"   x_offset="0.0" y_offset="-0.4"/>
    <xacro:rover_wheel prefix="rear_right"  x_offset="-0.4" y_offset="-0.4"/>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>mid_left_wheel_joint</left_joint>
            <left_joint>rear_left_wheel_joint</left_joint>

            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>mid_right_wheel_joint</right_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            
            <wheel_separation>0.8</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            
            <topic>cmd_vel</topic>
        </plugin>
    </gazebo>

</robot>